\set ON_ERROR_ROLLBACK interactive
\set COMP_KEYWORD_CASE upper
\set VERBOSITY verbose

-- Visible NULLs.
\pset null '(null)'

-- Switch to expanded table format if needed.
\x auto

-- Prompt
\set PROMPT1 '%n@%M:%>%x %/# '
\set PROMPT2 ''

-- Separate history for each database.
\set HISTFILE ~/.local/share/psql/history_ :DBNAME
\set HISTSIZE 9999
